# Python cache & compiled files
__pycache__/
*.py[cod]
*.pyo

# Build & distribution artifacts
build/
dist/
*.egg-info/


# Data (usually too large / sensitive for git) — anchored: must not match src/data/, which is real source code
/data/

# Terraform state (can contain secrets)
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup

# Data files
*.csv
*.parquet
*.json
*.feather
*.pkl
*.pickle

# Plots & figures
*.png
*.jpg
*.jpeg
*.pdf
*.svg
!docs/**/*.svg
!dashboard/docs/**/*.png
/plots/
/figures/
/outputs/

# MLflow local tracking store
mlruns/

# Generated run-comparison reports (utils/run_comparison.py output)
/reports/

# Session-export HTML artifacts
/.lavish/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/


# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Node.js
node_modules/

# macOS
.DS_Store

# IDEs
.vscode/
.idea/